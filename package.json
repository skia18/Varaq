{
  "name": "varaq",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo for the Varaq application",
  "workspaces": [
    "apps/varaq-frontend"
  ],
  "scripts": {
    "api:validate-spec": "openapi-generator-cli validate -i apps/varaq-backend/apispec/openapi.yaml",
    "api:generate:web": "openapi-generator-cli generate -i apps/varaq-backend/apispec/openapi.yaml -g typescript-fetch -o apps/varaq-frontend/src/generated/api && node scripts/finalize-generated-api.mjs",
    "dev:web": "npm run dev --workspace=varaq-frontend",
    "build:web": "npm run build --workspace=varaq-frontend",
    "test": "npm run test:web && npm run test:go",
    "test:web": "npm run test --workspace=varaq-frontend",
    "test:watch": "npm run test:watch --workspace=varaq-frontend",
    "lint": "npm run lint:web && npm run lint:go",
    "lint:web": "npm run lint --workspace=varaq-frontend",
    "lint:go": "cd apps/varaq-backend && go vet ./...",
    "format": "npm run format:web && npm run format:go",
    "format:web": "npm run format --workspace=varaq-frontend",
    "format:go": "cd apps/varaq-backend && gofmt -w .",
    "test:go": "cd apps/varaq-backend && go test ./...",
    "dev:go": "cd apps/varaq-backend && go run cmd/api/main.go"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skia18/Varaq.git"
  },
  "author": "skia18",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/skia18/Varaq/issues"
  },
  "homepage": "https://github.com/skia18/Varaq#readme",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.14.0",
    "supabase": "^2.121.0"
  }
}
