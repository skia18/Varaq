{
  "name": "varaq",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo for the Varaq application",
  "workspaces": [
    "apps/varaq-frontend/varaq"
  ],
  "scripts": {
    "api:generate:web": "openapi-generator-cli generate -i apps/varaq-backend/apispec/openapi.yaml -g typescript-fetch -o apps/varaq-frontend/varaq/generated/api",
    "dev:web": "npm run dev --workspace=apps/varaq-frontend/varaq",
    "build:web": "npm run build --workspace=apps/varaq-frontend/varaq"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skia18/Varaq.git"
  },
  "author": "skia18",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/skia18/Varaq/issues"
  },
  "homepage": "https://github.com/skia18/Varaq#readme",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.14.0"
  }
}
